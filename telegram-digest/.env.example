# https://my.telegram.org -> API development tools
TG_API_ID=1234567
TG_API_HASH=0123456789abcdef0123456789abcdef
TG_SESSION=digest

# https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=sk-ant-...

# Model va effort (arzonroq variant: DIGEST_MODEL=claude-haiku-5-5)
DIGEST_MODEL=claude-opus-5-5
DIGEST_EFFORT=low

# Birinchi ishga tushirishda necha soatlik xabar o'qilsin
LOOKBACK_HOURS=24
# Bitta chatdan bir martada maksimal nechta xabar
MAX_PER_CHAT=100
# Digestga kirish uchun minimal ball (1-10)
MIN_SCORE=6
# --loop rejimida necha daqiqada bir tekshirish
LOOP_MINUTES=60

# Vergul bilan: username yoki chat nomi. INCLUDE bo'sh bo'lsa - hamma chatlar.
INCLUDE_CHATS=
EXCLUDE_CHATS=
# Botlar bilan chatlarni o'tkazib yuborish (1/0)
SKIP_BOTS=1
